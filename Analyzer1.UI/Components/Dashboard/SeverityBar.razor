<div class="bar-row">
    <div class="bar-label" style="color:var(--@Color-color)">@Label</div>
    <div class="bar-track">
        <div class="bar-fill @Color" style="width:@Width%"></div>
    </div>
    <div class="bar-count">@Count</div>
</div>

@code {
    [Parameter] public string Label { get; set; } = "";
    [Parameter] public string Color { get; set; } = "info";
    [Parameter] public int Count { get; set; }
    [Parameter] public int Max { get; set; } = 1;

    int Width => Max > 0 ? (int)Math.Round((double)Count * 100 / Max) : 0;
}
