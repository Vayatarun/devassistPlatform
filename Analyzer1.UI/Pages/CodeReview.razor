@page "/review1"
@using Microsoft.AspNetCore.Components.Forms
@inject HttpClient Http
@inject IJSRuntime JS

<h3>SVN Diff Code Review</h3>

<InputFile OnChange="UploadFile" />

@if (uploading)
{
    <p>Analyzing diff file...</p>
}

@code {

    bool uploading = false;

    async Task UploadFile(InputFileChangeEventArgs e)
    {
        uploading = true;

        var file = e.File;

        var content = new MultipartFormDataContent();

        var fileStream = file.OpenReadStream();

        content.Add(new StreamContent(fileStream), "diffFile", file.Name);
        content.Add(new StringContent("0"), "Sheettype");
        var response = await Http.PostAsync("api/review/upload", content);

        var bytes = await response.Content.ReadAsByteArrayAsync();

        await JS.InvokeVoidAsync("downloadFile", "CodeReviewReport.xlsx", bytes);

        uploading = false;
    }
}